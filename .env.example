# Copy to .env for local development and replace the placeholder password.
POSTGRES_DB=git_agent
POSTGRES_USER=git_agent
POSTGRES_PASSWORD=replace-with-a-local-password

# Host-side application connection URLs (used by the local .env configuration).
DATABASE_URL=postgresql+asyncpg://git_agent:replace-with-a-local-password@localhost:5432/git_agent
REDIS_URL=redis://localhost:6379/0
